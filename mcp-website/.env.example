# Non-secret local configuration. Cloud builds require explicit injected config.
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:5001/demo-mcp-local/us-central1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mcp-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-mcp-local.appspot.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mcp-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:localfixture
NEXT_PUBLIC_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_STORAGE_EMULATOR_HOST=127.0.0.1:9199
NEXT_PUBLIC_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
NEXT_PUBLIC_PAYPAL_ENV=fake
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb
NEXT_PUBLIC_ENABLE_ANALYTICS=false
